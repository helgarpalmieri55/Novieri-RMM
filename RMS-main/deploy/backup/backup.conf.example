# Platform backup settings, read by deploy/scripts/scheduled-backup.sh and
# restore-drill.sh. install-backup-timer.sh copies this to
# /etc/it-suite/backup.conf (root:root, mode 600) once and never overwrites it.
# KEY=value lines only; no quotes, no spaces around '=', no shell.

# Where nightly backups go. A separate disk or mount is better than the root
# filesystem; never inside the repository or Docker's data root.
BACKUP_ROOT=/var/backups/it-suite

# Keep dated database backups this many days, and never fewer than RETAIN_MIN.
RETAIN_DAYS=14
RETAIN_MIN=3

# Object storage (MinIO) in the backup:
#   all               the whole bucket, fleet backup data included
#   no-fleet-backups  everything except fleet backup data (*/backup/*): use
#                     this once Backup -> Off-site copy protects fleet data
#   none              databases only
OBJECTS=all

# Off-host copy of each night's backup: none | rsync | s3
OFFSITE=none

# Encrypt the database backup before it leaves the host (it holds role
# password hashes). An age public key (age1...). Requires `age` installed.
OFFSITE_AGE_RECIPIENT=
# Without a recipient the copy is refused unless you set this to yes.
OFFSITE_ALLOW_UNENCRYPTED=no
# Also copy the objects mirror off-host (unencrypted; yes | no). Fleet
# backup chunks in it are already encrypted by the agent; attachments,
# recordings and packages are not.
OFFSITE_OBJECTS=no

# OFFSITE=rsync: an rsync-over-ssh destination and a dedicated key.
OFFSITE_RSYNC_TARGET=
OFFSITE_SSH_KEY=/etc/it-suite/backup-offsite.key

# OFFSITE=s3: any S3-compatible endpoint, mirrored with mc. Use a key that
# can only write this bucket; set retention on the bucket itself.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=itms-platform
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
