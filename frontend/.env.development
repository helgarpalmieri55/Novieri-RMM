# Local development ONLY. Vite loads this file for `npm run dev` and never for
# a production build, so nothing here reaches a deployed image.
#
# In production the console derives Keycloak's address from its own origin,
# because Traefik serves /realms on the same host (see lib/auth.ts). That is not
# true of the dev server, which runs on :5173 while Keycloak runs on :8080 —
# hence this override, and hence why it must stay development-only. A value like
# this one in a production build is exactly the defect auth.test.ts exists for.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/it-suite
